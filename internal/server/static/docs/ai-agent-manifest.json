{
  "schema": "rdev.ai-agent-manifest.v7",
  "default_authentication": "permanent_device_token",
  "windows_launchers": {
    "cmd": "/run.cmd",
    "powershell": "/run-cmd.ps1",
    "minimum_powershell": "not_required_for_windows7_cmd",
    "legacy_windows_prerequisites": "Windows 7 SP1 with BITS and current root certificates; CMD path uses the self-contained Go client",
    "legacy_windows_runtime_acceptance": "pending_real_windows7",
    "credential_transport": "process_environment_or_interactive_prompt"
  },
  "permanent_access": {
    "schema": "rdev-device-access.v1",
    "fields": [
      "schema",
      "device_id",
      "rdev_base",
      "api_base",
      "ssh_host",
      "ssh_port",
      "token"
    ],
    "additional_fields": false,
    "issuer_ui": "https://pan.feidu.fit/rdev",
    "expiry": "none",
    "import": {
      "windows": "python rdev-agent.py --import-clipboard",
      "unix": "python3 rdev-agent.py --import-stdin"
    },
    "select": "--device EXACT-ID",
    "credentials": {
      "ssh_password": "token",
      "FEIDU_DRIVE_TOKEN": "token"
    },
    "tool": "/skills/rdev-agent/scripts/rdev-agent.py",
    "tool_sha256": "af5360c661651494faf8c7a380b50216a1ffd6f33d18d54b9efa8e766676760d",
    "stdin_encoding": "utf-8; utf-16/utf-32 require BOM",
    "skill": "/skills/rdev-agent/SKILL.md",
    "input": "access_json_or_handoff_with_one_json_code_block"
  },
  "capabilities": [
    "ssh",
    "sftp",
    "scp",
    "port_forward",
    "web_terminal",
    "web_desktop",
    "drive",
    "cloud_transfer"
  ],
  "cloud_transfers": {
    "endpoints": {
      "create": "POST /developer/v1/rdev/transfers",
      "list": "GET /developer/v1/rdev/transfers",
      "get": "GET /developer/v1/rdev/transfers/{transfer_id}",
      "pause": "POST /developer/v1/rdev/transfers/{transfer_id}/pause",
      "resume": "POST /developer/v1/rdev/transfers/{transfer_id}/resume",
      "cancel": "POST /developer/v1/rdev/transfers/{transfer_id}/cancel"
    },
    "identity": "account_device_root_derived_from_token_binding",
    "list_response": "data.items",
    "transfer_response": "data.transfer",
    "recovery": "resume_original_transfer_id_with_fixed_token",
    "automatic_resume_attempts": 2
  },
  "artifact_plane": {
    "base_url": "https://pan.feidu.fit",
    "token_env": "FEIDU_DRIVE_TOKEN",
    "download": [
      "GET /developer/v1/capabilities",
      "GET /developer/v1/contents",
      "GET /developer/v1/contents/{content_id}",
      "GET /developer/v1/contents/{content_id}/download"
    ],
    "upload": [
      "POST /developer/v1/direct-upload-sessions",
      "GET /developer/v1/direct-upload-sessions/{session_id}",
      "PUT /developer/v1/direct-upload-sessions/{session_id}/parts/{part_number}",
      "POST /developer/v1/direct-upload-sessions/{session_id}/parts/refresh",
      "POST /developer/v1/direct-upload-sessions/{session_id}/rapid-proof",
      "POST /developer/v1/direct-upload-sessions/{session_id}/complete",
      "POST /developer/v1/direct-upload-sessions/{session_id}/cancel"
    ],
    "lifecycle": [
      "none",
      "hide",
      "archive"
    ]
  },
  "documentation": {
    "human": "/docs/ai-agent-artifact-bridge.md",
    "repository": "docs/ai-agent-artifact-bridge.md"
  },
  "ssh_websocket": {
    "endpoint": "/ssh-ws?device=EXACT-ID",
    "subprotocols": [
      "rdev-browser-v1",
      "rdev-access-ticket.<credential>"
    ],
    "authentication": "ssh-capable permanent token or delegated non-browser device ticket",
    "inner_ssh_user": "exact outer device ID",
    "transport_selection": "auto (default): raw SSH banner probe, WSS fallback before execution; explicit raw or wss; no command replay",
    "python_dependency": "websockets>=15,<17",
    "proxy": "system HTTPS proxy; verified TLS; no redirects",
    "max_binary_message_bytes": 65536,
    "empty_binary_message": "write EOF; keep reading opposite direction",
    "limits": {
      "per_device": 8,
      "global": 128,
      "handshake_seconds": 15,
      "idle_seconds": 90,
      "write_seconds": 15,
      "lifetime_seconds": 86400
    },
    "forwarding": "WSS rejects TCP, Agent, X11 forwarding; select raw for -L/-R/-N"
  },
  "device_management": {
    "authentication": "backend_control_token_header",
    "header": "X-RDev-Control-Token",
    "guide": "/docs/device-management.md",
    "name": "PATCH /api/control/devices/{exactDeviceId}/name",
    "read_name": "GET /api/control/devices/{exactDeviceId}/name?subject={subject}",
    "dispatch": "POST /api/control/devices/{exactDeviceId}/actions",
    "result": "GET /api/control/devices/{exactDeviceId}/actions?subject={subject}&requestId={requestId}",
    "client_capability": "deviceManagementV1",
    "actions": [
      "upgrade",
      "stop",
      "uninstall"
    ],
    "identity": "exact_managed_device_id_and_current_instance",
    "display_name_persistence": "managed_device_registry_v6",
    "result_retention": "in_memory_24_hours_max_1024_no_replay",
    "uninstall": "explicit_confirmation_and_local_opt_in_standard_linux_systemd_only",
    "delete_identity_default": false
  }
}
