{
  "schema": "rdev.ai-agent-manifest.v6",
  "default_authentication": "permanent_device_token",
  "windows_launchers": {
    "cmd": "/run.cmd",
    "powershell": "/run-cmd.ps1",
    "minimum_powershell": "5.1",
    "legacy_windows_prerequisites": "Windows 7 SP1, .NET 4.8, WMF 5.1, TLS 1.2",
    "legacy_windows_runtime_acceptance": "pending_real_windows7",
    "credential_transport": "process_environment_or_interactive_prompt"
  },
  "permanent_access": {
    "schema": "rdev-device-access.v1",
    "fields": [
      "schema",
      "device_id",
      "rdev_base",
      "api_base",
      "ssh_host",
      "ssh_port",
      "token"
    ],
    "additional_fields": false,
    "issuer_ui": "https://pan.feidu.fit/rdev",
    "expiry": "none",
    "import": {
      "windows": "python rdev-agent.py --import-clipboard",
      "unix": "python3 rdev-agent.py --import-stdin"
    },
    "select": "--device EXACT-ID",
    "credentials": {
      "ssh_password": "token",
      "FEIDU_DRIVE_TOKEN": "token"
    },
    "tool": "/skills/rdev-agent/scripts/rdev-agent.py",
    "tool_sha256": "7a1d2c08fadecbf1abf988a50349b7959ad40df04eb659c3758c29f3e7d7c83c",
    "stdin_encoding": "utf-8; utf-16/utf-32 require BOM",
    "skill": "/skills/rdev-agent/SKILL.md",
    "input": "access_json_or_handoff_with_one_json_code_block"
  },
  "capabilities": [
    "ssh",
    "sftp",
    "scp",
    "port_forward",
    "web_terminal",
    "web_desktop",
    "drive",
    "cloud_transfer"
  ],
  "cloud_transfers": {
    "endpoints": {
      "create": "POST /developer/v1/rdev/transfers",
      "list": "GET /developer/v1/rdev/transfers",
      "get": "GET /developer/v1/rdev/transfers/{transfer_id}",
      "pause": "POST /developer/v1/rdev/transfers/{transfer_id}/pause",
      "resume": "POST /developer/v1/rdev/transfers/{transfer_id}/resume",
      "cancel": "POST /developer/v1/rdev/transfers/{transfer_id}/cancel"
    },
    "identity": "account_device_root_derived_from_token_binding",
    "list_response": "data.items",
    "transfer_response": "data.transfer",
    "recovery": "resume_original_transfer_id_with_fixed_token",
    "automatic_resume_attempts": 2
  },
  "artifact_plane": {
    "base_url": "https://pan.feidu.fit",
    "token_env": "FEIDU_DRIVE_TOKEN",
    "download": [
      "GET /developer/v1/capabilities",
      "GET /developer/v1/contents",
      "GET /developer/v1/contents/{content_id}",
      "GET /developer/v1/contents/{content_id}/download"
    ],
    "upload": [
      "POST /developer/v1/direct-upload-sessions",
      "GET /developer/v1/direct-upload-sessions/{session_id}",
      "PUT /developer/v1/direct-upload-sessions/{session_id}/parts/{part_number}",
      "POST /developer/v1/direct-upload-sessions/{session_id}/parts/refresh",
      "POST /developer/v1/direct-upload-sessions/{session_id}/rapid-proof",
      "POST /developer/v1/direct-upload-sessions/{session_id}/complete",
      "POST /developer/v1/direct-upload-sessions/{session_id}/cancel"
    ],
    "lifecycle": [
      "none",
      "hide",
      "archive"
    ]
  },
  "documentation": {
    "human": "/docs/ai-agent-artifact-bridge.md",
    "repository": "docs/ai-agent-artifact-bridge.md"
  }
}
