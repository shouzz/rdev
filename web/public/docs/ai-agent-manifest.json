{
  "schema": "rdev.ai-agent-manifest.v4",
  "handoff": {
    "issuer_ui": "https://pan.feidu.fit/rdev",
    "claim_prefix": "fdhc_",
    "claim_ttl_seconds": 300,
    "claim_input": "stdin_or_hidden_prompt",
    "redeem": {
      "method": "POST",
      "url": "https://pan.feidu.fit/agent/v1/handoffs/redeem",
      "content_type": "application/json",
      "body": {"claim": "<runtime fdhc_ claim>"},
      "required_http_status": 200,
      "required_json_code": 0
    },
    "credential_fields": {
      "device_id": "data.credentials.device_id",
      "rdev_ticket": "data.credentials.rdev_ticket.ticket",
      "developer_token": "data.credentials.developer_token.token",
      "agent_session_id": "data.credentials.agent_session.agent_session_id",
      "renewal_token": "data.credentials.agent_session.renewal_token"
    },
    "credential_max_ttl_seconds": 28800,
    "session_duration_hours": [2, 8, 24],
    "single_use": true
  },
  "agent_session": {
    "renewal_token_prefix": "fdrn_",
    "minimum_safety_margin_seconds": 600,
    "renew_before_seconds": 900,
    "endpoints": {
      "heartbeat": "POST /agent/v1/sessions/{agent_session_id}/heartbeat",
      "renew": "POST /agent/v1/sessions/{agent_session_id}/renew",
      "revoke": "DELETE /agent/v1/sessions/{agent_session_id}",
      "transfer_create": "POST /agent/v1/sessions/{agent_session_id}/transfers",
      "transfer_get": "GET /agent/v1/sessions/{agent_session_id}/transfers/{transfer_id}",
      "transfer_pause": "POST /agent/v1/sessions/{agent_session_id}/transfers/{transfer_id}/pause",
      "transfer_resume": "POST /agent/v1/sessions/{agent_session_id}/transfers/{transfer_id}/resume",
      "transfer_cancel": "POST /agent/v1/sessions/{agent_session_id}/transfers/{transfer_id}/cancel"
    },
    "status_fields": ["ticket_remaining_seconds", "developer_token_remaining_seconds", "estimated_transfer_seconds", "minimum_safety_margin_seconds", "renewal_due_at_ms", "absolute_expires_at_ms", "selected_transport"],
    "renewal_token_policy": "stable_until_absolute_expiry_or_revoke",
    "renewal_response": "data.session",
    "credential_policy": "values_stable_expiry_extended_in_place",
    "state_storage": {"windows": "current-user DPAPI", "unix": "mode 0600"},
    "tool": "/skills/rdev-agent/scripts/rdev-agent.py",
    "skill": "/skills/rdev-agent/SKILL.md"
  },
  "rdev": {
    "base_url": "https://r.feidu.fit",
    "discovery": ["GET /api/config"],
    "device_id_source": "data.credentials.device_id",
    "password_source": "data.credentials.rdev_ticket.ticket",
    "protected_endpoints_not_required": ["GET /api/clients"],
    "device_operations": ["ssh", "exec", "scp", "sftp", "rsync", "port_forward", "remote_desktop"],
    "verified_windows_scp": {
      "client_version": "go/v0.2.121-feidu.7",
      "asset": "rdev-client-windows-amd64.exe",
      "sha256": "153d4b37e3ab81bc6507314dde09b70557d7785401365caaf07992977b853117",
      "fallback_for_other_versions": "sftp"
    },
    "file_websocket": {
      "url": "wss://r.feidu.fit/files",
      "auth_message": {"op": "auth", "deviceId": "<device id>", "password": "<runtime secret>"},
      "binary_frame": "[type:1][task_id_length:1][task_id][offset:uint64_be][payload]",
      "types": {"upload_chunk": "0x20", "upload_ack": "0x21", "download_chunk": "0x22", "transfer_end": "0x23", "cancel": "0x24"}
    },
    "managed_enrollment": {
      "issuer_ui": "https://pan.feidu.fit/rdev",
      "public_join": "https://r.feidu.fit/join#<runtime rdeve_ code>",
      "code_prefix": "rdeve_",
      "modes": ["temporary", "persistent"],
      "persistent_identity": "OS-protected identity file",
      "secret_storage": "server bcrypt hash only",
      "persistent_transport": "wss://r.feidu.fit",
      "persistent_reenrollment": {
        "client_flag": "--replace-existing",
        "allowed_scope": "same owner and exact managed device ID",
        "effect": "rotate device secret, revoke old access tickets, disconnect old connection",
        "conflict_http_status": 409
      }
    }
  },
  "artifact_plane": {
    "base_url": "https://pan.feidu.fit",
    "token_env": "FEIDU_DRIVE_TOKEN",
    "cli": "python3 tools/feidu-drive.py",
    "download": ["GET /developer/v1/capabilities", "GET /developer/v1/contents", "GET /developer/v1/contents/{content_id}", "GET /developer/v1/contents/{content_id}/download"],
    "upload": ["POST /developer/v1/direct-upload-sessions", "GET /developer/v1/direct-upload-sessions/{session_id}", "PUT /developer/v1/direct-upload-sessions/{session_id}/parts/{part_number}", "POST /developer/v1/direct-upload-sessions/{session_id}/parts/refresh", "POST /developer/v1/direct-upload-sessions/{session_id}/rapid-proof", "POST /developer/v1/direct-upload-sessions/{session_id}/complete", "POST /developer/v1/direct-upload-sessions/{session_id}/cancel"],
    "token_prefix": "fdpat_",
    "lifecycle": ["none", "hide", "archive"],
    "rules": ["use content_id only", "never log token", "never persist signed URL", "sequential multipart with max 3 attempts per part", "HTTP 200 or 409 means part accepted"]
  },
  "bridge": {
    "automatic_threshold_bytes": 104857600,
    "automatic_large_file": {
      "local_staging_required": false,
      "cloud_to_device": ["browser_multipart_to_aliyundrive", "device_https_download", "size_sha1_verify", "atomic_publish"],
      "device_to_cloud": ["device_size_sha1_verify", "device_sequential_multipart_to_aliyundrive", "result_content_id_bind", "browser_download_ticket"],
      "transfer_states": ["queued", "running", "paused", "completed", "failed", "cancelled"],
      "transfer_token_prefix": "fdtx_",
      "transfer_generation": "positive_uint64_monotonic_per_transfer",
      "dispatch_acceptance": "device_plan_and_running_progress_acknowledged",
      "client_acceptance_timeout_seconds": 7,
      "rdev_dispatch_ack_timeout_seconds": 8,
      "download_part_suffix": ".rdev-cloud.part"
    },
    "manual_agent_workflow": {
      "local_staging_required": true,
      "cloud_to_device": ["artifact_download", "hash_verify", "rdev_scp_or_sftp_upload", "device_hash_verify"],
      "device_to_cloud": ["device_hash_verify", "rdev_scp_or_sftp_download", "artifact_upload", "content_id_record"]
    },
    "integrity": ["size", "sha256_local", "sha256_remote"],
    "secret_policy": "handoff_claim_and_credentials_runtime_only"
  },
  "documentation": {
    "human": "/docs/ai-agent-artifact-bridge.md",
    "repository": "docs/ai-agent-artifact-bridge.md"
  }
}
